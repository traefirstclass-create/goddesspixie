# --- Redis (Vercel Marketplace -> Redis (Upstash) -> Connect to project injects these) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Resend (resend.com) - transactional email for contact form + order notices/download links ---
RESEND_API_KEY=
RESEND_FROM_EMAIL="Goddess Pixie <noreply@yourdomain.com>"

# Where contact-form submissions and "new order" notifications go
OWNER_NOTIFY_EMAIL=goddesspixie7@outlook.com

# --- Admin dashboard (approves orders, at /admin) ---
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# --- Google Drive service account (server-side only file delivery) ---
# Create a GCP project -> Service Account -> enable Drive API -> generate a JSON key.
# Share the specific Drive files/folder with the service account's email as Viewer.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file. Keep the \n escapes literal.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Public site config ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CASHAPP_HANDLE=$pixieinthehoops7
NEXT_PUBLIC_VENMO_HANDLE=@pixieinthehoops7
